      <h2 class="mt-8 text-xl font-bold text-white">14. Bizimlə Əlaqə</h2>
      <p class="text-stone-300">
        Bu Məxfilik Siyasəti ilə bağlı hər hansı sualınız olarsa, bizimlə əlaqə saxlaya bilərsiniz:<br />
        <strong>E-poçt:</strong>
        <a href="mailto:aa.dev45@gmail.com" class="text-primary hover:underline">aa.dev45@gmail.com</a><br />
        <strong>Botaz-a etimad göstərdiyiniz üçün təşəkkür edirik.</strong>
      </p>
    </div>
  </div>
</Layout>

<!-- Dil dəyişdirmə funksionallığı üçün script -->
<script>
  function setupPrivacyLanguageToggle() {
    const buttons = document.querySelectorAll('.lang-btn');
    const contents = document.querySelectorAll('.lang-content');

    const savedLang = localStorage.getItem('botaz_privacy_lang') || 'en';
    switchLanguage(savedLang);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        if (lang) {
          switchLanguage(lang);
          localStorage.setItem('botaz_privacy_lang', lang);
        }
      });
    });

    function switchLanguage(lang: string) {
      buttons.forEach((b) => {
        if (b.getAttribute('data-lang') === lang) {
          b.classList.add('bg-white', 'text-stone-900', 'shadow');
          b.classList.remove('text-stone-400');
        } else {
          b.classList.remove('bg-white', 'text-stone-900', 'shadow');
          b.classList.add('text-stone-400');
        }
      });

      contents.forEach((c) => {
        if (c.getAttribute('data-lang') === lang) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });

      const headlineContainer = document.querySelector('#page-headline');
      if (headlineContainer) {
        headlineContainer.innerHTML = lang === 'az' ? '<h1 class="text-3xl font-bold text-white sm:text-4xl">Məxfilik Siyasəti</h1>' : '<h1 class="text-3xl font-bold text-white sm:text-4xl">Privacy Policy</h1>';
      }
    }
  }

  setupPrivacyLanguageToggle();
  document.addEventListener('astro:page-load', setupPrivacyLanguageToggle);
</script>
