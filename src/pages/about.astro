---

<Layout title={localizedContent.en.title} description={localizedContent.en.description} >
  <!-- Yuxarı hissə: Başlıq və Dil Seçici düyməsi -->
  <div class="flex flex-col gap-4 pb-10 sm:flex-row sm:items-center sm:justify-between">
    <div id="page-headline">
      <Headline text="About Us" class="pb-0" />
    </div>

    <!-- Dil Dəyişdirmə Düyməsi -->
    <div class="flex items-center self-start sm:self-auto">
      <div class="inline-flex rounded-full border border-stone-800 bg-stone-900 p-1" role="group" aria-label="Dil seçimi">
        <button type="button" class="lang-btn rounded-full px-4 py-1.5 text-xs font-semibold text-stone-400 transition-colors" data-lang="az"> AZ </button>
        <button type="button" class="lang-btn rounded-full px-4 py-1.5 text-xs font-semibold text-stone-400 transition-colors" data-lang="en"> EN </button>
      </div>
    </div>
  </div>

  <!-- English Container (Default) -->
  <div class="lang-content" data-lang="en">
    <AboutContent {...localizedContent.en} {locale} />
  </div>

  <!-- Azerbaijani Container -->
  <div class="lang-content hidden" data-lang="az">
    <AboutContent {...localizedContent.az} {locale} />
  </div>
</Layout>

<!-- Dil dəyişdirmə funksionallığı üçün script -->
<script>
  function setupAboutLanguageToggle() {
    const buttons = document.querySelectorAll('.lang-btn');
    const contents = document.querySelectorAll('.lang-content');

    const savedLang = localStorage.getItem('botaz_about_lang') || 'en';
    switchLanguage(savedLang);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        if (lang) {
          switchLanguage(lang);
          localStorage.setItem('botaz_about_lang', lang);
        }
      });
    });

    function switchLanguage(lang: string) {
      buttons.forEach((b) => {
        if (b.getAttribute('data-lang') === lang) {
          b.classList.add('bg-white', 'text-stone-900', 'shadow');
          b.classList.remove('text-stone-400');
        } else {
          b.classList.remove('bg-white', 'text-stone-900', 'shadow');
          b.classList.add('text-stone-400');
        }
      });

      contents.forEach((c) => {
        if (c.getAttribute('data-lang') === lang) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });

      const headlineContainer = document.querySelector('#page-headline');
      if (headlineContainer) {
        headlineContainer.innerHTML = lang === 'az' ? '<h1 class="text-3xl font-bold text-white sm:text-4xl">Haqqımızda</h1>' : '<h1 class="text-3xl font-bold text-white sm:text-4xl">About Us</h1>';
      }
    }
  }

  setupAboutLanguageToggle();
  document.addEventListener('astro:page-load', setupAboutLanguageToggle);
</script>
