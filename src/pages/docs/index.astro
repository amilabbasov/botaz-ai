---
import { Icon } from "astro-icon/components";
import { useTranslations } from "../../utils/i18n";
import { themeConfig } from "../../../theme.config";
import { SITE_CONFIG } from "../../site.config";

interface Props {
  locale?: string;
}

const { locale = themeConfig.i18n.defaultLocale } = Astro.props;
const t = useTranslations(locale);

const steps = [
  { title: "Tələblərinizi Bildirin", text: "Biznesinizə uyğun AI həllini müəyyən etmək üçün tələblərinizi bizə göndərin." },
  { title: "Həllin Hazırlanması", text: "Botaz komandası sizin üçün xüsusi bot və ya avtomatlaşdırma sistemini qurur." },
  { title: "İnteqrasiya və Dəstək", text: "Sistem tam hazır olduqdan sonra biznesinizə inteqrasiya olunur və dəstək göstərilir." },
];
---

<div class="flex flex-col gap-14">
  <p class="max-w-2xl text-lg text-stone-600 dark:text-stone-300">
    Botaz AI ilə biznesinizi növbəti səviyyəyə qaldırın. Aşağıdakı addımlarla bizimlə asanlıqla əməkdaşlığa başlaya bilərsiniz.
  </p>

  <!-- Steps -->
  <section>
    <h2 class="mb-8 text-2xl font-bold">Necə İşləyirik?</h2>
    <ol class="m-0 flex list-none flex-col gap-6 p-0">
      {
        steps.map((step, index) => (
          <li class="relative m-0 flex gap-4 rounded-lg border border-stone-300 bg-white p-5 dark:border-stone-700 dark:bg-stone-900">
            <span class="bg-primary text-primary-contrast flex h-9 w-9 shrink-0 items-center justify-center rounded-full font-bold select-none" aria-hidden="true">
              {index + 1}
            </span>
            <div class="flex flex-col gap-1">
              <h3 class="font-bold">{step.title}</h3>
              <p class="text-sm text-stone-600 dark:text-stone-300">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- WhatsApp Contact Section -->
  <section class="rounded-lg border border-stone-300 bg-white p-5 dark:border-stone-700 dark:bg-stone-900">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-stone-200 text-stone-700 dark:bg-stone-700 dark:text-stone-200">
        <Icon name="heroicons:chat-bubble-left-right" class="h-6 w-6" aria-hidden="true" />
      </span>
      <div class="flex flex-col gap-3">
        <h2 class="text-xl font-bold">Sualınız var?</h2>
        <p class="text-sm text-stone-600 dark:text-stone-300">Bizim komanda ilə birbaşa əlaqə saxlayın və layihənizi müzakirə edək.</p>
        <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary w-fit rounded px-4 py-2 flex items-center gap-2">
          <Icon name="simple-icons:whatsapp" class="h-5 w-5" aria-hidden="true" />
          WhatsApp-da Yaz
          <Icon name="heroicons:arrow-top-right-on-square" class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</div>