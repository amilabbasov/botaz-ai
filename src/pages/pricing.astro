---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import { Icon } from "astro-icon/components";
import { useTranslations } from "@utils/i18n";
import { themeConfig } from "~/theme.config";
import { SITE_CONFIG } from "../site.config";

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);

const plans = [
  {
    id: "lite",
    name: "Lite",
    badge: null,
    featured: false,
    dailyPrice: "1.63 AZN",
    monthlyPrice: "49 AZN",
    monthlySubtext: "aylıq ödəniş",
    annualEquivalent: "49 AZN",
    annualTotalPrice: "490 AZN / il",
    noteMonthly: "İlk ay yarı qiymətə",
    noteAnnual: "2 ay hədiyyə",
    description: "Kiçik bizneslər və yeni başlayan mağazalar üçün.",
    features: [
      "1 Instagram Business hesabı",
      "1.000 AI cavabı / ay",
      "Standart AI satış köməkçisi",
      "Məhsul kataloqunun öyrədilməsi",
      "FAQ-ların Botaz-a öyrədilməsi",
      "Real alıcı toplama (Ad + Telefon)",
      "Telegram və ya Email bildirişləri",
    ],
  },
  {
    id: "business",
    name: "Business",
    badge: "Ən Populyar",
    featured: true,
    dailyPrice: "3.30 AZN",
    monthlyPrice: "99 AZN",
    monthlySubtext: "aylıq ödəniş",
    annualEquivalent: "99 AZN",
    annualTotalPrice: "990 AZN / il",
    noteMonthly: "İlk ay yarı qiymətə",
    noteAnnual: "2 ay hədiyyə",
    description: "Aktiv satış edən və daha çox avtomatlaşdırma istəyən bizneslər üçün.",
    features: [
      "10.000 AI cavabı / ay",
      "İstənilən danışıq üslubu (Ağdamlı, Naxçıvanlı, Şən, Rəsmi, Satış Mütəxəssisi və s.)",
      "Aylıq performans hesabatı",
      "Prioritet AI emalı",
      "Xüsusi tonlaşdırma",
      "Prioritet dəstək",
    ],
  },
  {
    id: "pro",
    name: "Pro",
    badge: null,
    featured: false,
    dailyPrice: "6.63 AZN",
    monthlyPrice: "199 AZN",
    monthlySubtext: "aylıq ödəniş",
    annualEquivalent: "199 AZN",
    annualTotalPrice: "1.990 AZN / il",
    noteMonthly: "İlk ay yarı qiymətə",
    noteAnnual: "2 ay hədiyyə",
    description: "Yüksək mesaj həcmi olan bizneslər və agentliklər üçün.",
    features: [
      "2 Instagram Business hesabı",
      "20.000 AI cavabı / ay",
      "Prioritet texniki dəstək",
      "Yeni funksiyalara erkən giriş",
      "Beta funksiyalara giriş",
    ],
  },
];
---

<Layout title={t("pages.pricing.title")} description={t("pages.pricing.description")}>
  <div class="pt-root mx-auto max-w-6xl" data-period="monthly">
    <Headline text={t("pages.pricing.title")} class="pb-5" />

    <section class="mt-10 rounded-3xl border border-stone-800 bg-stone-950/70 p-6 shadow-lg shadow-black/10 sm:p-8">
      <div class="mb-8 flex flex-col items-center gap-4">
        <div class="inline-flex rounded-full border border-stone-800 bg-stone-900 p-1" role="group" aria-label="Ödəniş planı seçimi">
          <button
            type="button"
            class="pt-tab-btn rounded-full px-5 py-2 text-sm font-semibold text-stone-300 transition-colors"
            data-period="monthly"
            aria-pressed="true"
          >
            Aylıq
          </button>
          <button
            type="button"
            class="pt-tab-btn rounded-full px-5 py-2 text-sm font-semibold text-stone-300 transition-colors"
            data-period="annual"
            aria-pressed="false"
          >
            İllik <span class="ml-1 text-xs text-emerald-400 font-bold">2 ay hədiyyə</span>
          </button>
        </div>

        <p class="text-sm text-stone-400">
          İllik ödəniş edərək büdcənizə qənaət edin və xidmətdən fasiləsiz yararlanın.
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        {
          plans.map((plan) => {
            const monthlyMsg = `Salam, Botaz AI-ın "${plan.name}" (Aylıq) planı ilə maraqlanıram. Ətraflı məlumat almaq istəyirəm.`;
            const annualMsg = `Salam, Botaz AI-ın "${plan.name}" (İllik) planı ilə maraqlanıram. Ətraflı məlumat almaq istəyirəm.`;

            const monthlyUrl = `https://wa.me/${SITE_CONFIG.whatsappNumber}?text=${encodeURIComponent(monthlyMsg)}`;
            const annualUrl = `https://wa.me/${SITE_CONFIG.whatsappNumber}?text=${encodeURIComponent(annualMsg)}`;

            return (
              <article class:list={["pt-card flex flex-col justify-between rounded-3xl border bg-stone-900/80 p-6", plan.featured ? "border-primary ring-1 ring-primary/20" : "border-stone-800"]} data-plan={plan.id}>
                <div>
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="text-2xl font-bold text-white">{plan.name}</h3>
                      <p class="mt-2 text-sm leading-6 text-stone-300">{plan.description}</p>
                    </div>
                    {plan.badge && (
                      <span class="rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-amber-200">
                        {plan.badge}
                      </span>
                    )}
                  </div>

                  <div class="mt-6 rounded-2xl border border-stone-800 bg-stone-950/80 px-5 py-4">
                    <!-- Aylıq Rejim -->
                    <div class="pt-price monthly" data-period="monthly">
                      <div class="flex items-baseline gap-1.5">
                        <span class="text-4xl font-black tracking-tight text-white">{plan.dailyPrice}</span>
                        <span class="text-sm font-medium text-stone-400">/ gün</span>
                      </div>
                      <div class="mt-1.5 text-xs font-medium text-stone-400">
                        Cəmi <span class="text-stone-200 font-semibold">{plan.monthlyPrice}</span> ({plan.monthlySubtext})
                      </div>
                      <div class="mt-3 inline-flex rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                        {plan.noteMonthly}
                      </div>
                    </div>

                    <!-- İllik Rejim -->
                    <div class="pt-price hidden annual" data-period="annual">
                      <div class="flex items-baseline gap-1.5">
                        <span class="text-4xl font-black tracking-tight text-white">{plan.annualEquivalent}</span>
                        <span class="text-sm font-medium text-stone-400">/ ay</span>
                      </div>
                      <div class="mt-1.5 text-xs font-medium text-stone-400">
                        Cəmi <span class="text-stone-200 font-semibold">{plan.annualTotalPrice}</span> olaraq ödənilir
                      </div>
                      <div class="mt-3 inline-flex rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300">
                        {plan.noteAnnual}
                      </div>
                    </div>
                  </div>

                  <ul role="list" class="mt-6 space-y-3 text-sm text-stone-200">
                    {plan.features.map((feature) => (
                      <li class="flex items-start gap-3">
                        <Icon name="heroicons:check-circle" class="mt-0.5 h-5 w-5 shrink-0 text-primary" aria-hidden="true" />
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <a
                  href={monthlyUrl}
                  data-whatsapp-monthly={monthlyUrl}
                  data-whatsapp-annual={annualUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    "pt-whatsapp-btn btn-primary mt-8 w-full justify-center rounded-2xl px-5 py-3 text-base font-bold",
                    plan.featured ? "shadow-lg shadow-primary/10" : "",
                  ]}
                  aria-label={`${plan.name} planı üçün WhatsApp-da yaz`}
                >
                  <Icon name="simple-icons:whatsapp" class="h-5 w-5" aria-hidden="true" />
                  <span>WhatsApp-da Yaz</span>
                </a>
              </article>
            );
          })
        }
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupPricingTabs() {
    const root = document.querySelector<HTMLElement>('.pt-root');
    if (!root) return;

    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.pt-tab-btn'));
    const prices = Array.from(root.querySelectorAll<HTMLElement>('.pt-price'));
    const whatsappButtons = Array.from(root.querySelectorAll<HTMLAnchorElement>('.pt-whatsapp-btn'));

    const sync = (period: 'monthly' | 'annual') => {
      root.dataset.period = period;
      
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', button.dataset.period === period ? 'true' : 'false');
      });
      
      prices.forEach((price) => {
        price.classList.toggle('hidden', price.dataset.period !== period);
      });

      // İstifadəçi Aylıq/İllik dəyişdikdə düymənin WhatsApp linkini uyğun mətnlə yeniləyirik
      whatsappButtons.forEach((btn) => {
        const targetUrl = period === 'annual' ? btn.dataset.whatsappAnnual : btn.dataset.whatsappMonthly;
        if (targetUrl) {
          btn.href = targetUrl;
        }
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const period = button.dataset.period as 'monthly' | 'annual' | undefined;
        if (!period) return;
        sync(period);
      });
    });

    sync((root.dataset.period as 'monthly' | 'annual') || 'monthly');
  }

  setupPricingTabs();
  document.addEventListener('astro:page-load', setupPricingTabs);
</script>

<style>
  .pt-root[data-period='monthly'] .pt-tab-btn[data-period='monthly'],
  .pt-root[data-period='annual'] .pt-tab-btn[data-period='annual'] {
    background: var(--color-white);
    color: var(--color-stone-900);
  }

  :global(.dark) .pt-root[data-period='monthly'] .pt-tab-btn[data-period='monthly'],
  :global(.dark) .pt-root[data-period='annual'] .pt-tab-btn[data-period='annual'] {
    background: var(--color-primary-dark);
    color: var(--color-white);
  }
</style>