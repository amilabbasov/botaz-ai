<!-- Dil dəyişdirmə funksionallığı üçün script -->
<script>
  function setupLanguageToggle() {
    const buttons = document.querySelectorAll('.lang-btn');
    const contents = document.querySelectorAll('.lang-content');

    // Başlanğıc dili təyin et (məsələn: əgər yoxdursa 'en', varsa localStorage-dan oxu)
    const savedLang = localStorage.getItem('botaz_tos_lang') || 'en';
    switchLanguage(savedLang);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        if (lang) {
          switchLanguage(lang);
          localStorage.setItem('botaz_tos_lang', lang);
        }
      });
    });

    function switchLanguage(lang: string) {
      // Düymələrin aktiv/deaktiv görünüşü
      buttons.forEach((b) => {
        if (b.getAttribute('data-lang') === lang) {
          b.classList.add('bg-white', 'text-stone-900', 'shadow');
          b.classList.remove('text-stone-400');
        } else {
          b.classList.remove('bg-white', 'text-stone-900', 'shadow');
          b.classList.add('text-stone-400');
        }
      });

      // Məzmunların gizlədilməsi / göstərilməsi
      contents.forEach((c) => {
        if (c.getAttribute('data-lang') === lang) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });

      // Başlığı da dilə uyğun yeniləyək
      const headlineContainer = document.querySelector('#page-headline');
      if (headlineContainer) {
        headlineContainer.innerHTML = lang === 'az' ? '<h1 class="text-3xl font-bold text-white sm:text-4xl">İstifadə Şərtləri</h1>' : '<h1 class="text-3xl font-bold text-white sm:text-4xl">Terms of Service</h1>';
      }
    }
  }

  setupLanguageToggle();
  document.addEventListener('astro:page-load', setupLanguageToggle);
</script>
