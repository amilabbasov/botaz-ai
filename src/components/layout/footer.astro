---
import { Icon } from "astro-icon/components";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from '~/theme.config';
import { Image } from "astro:assets";
import logoWhite from '@images/logo-white.webp';
import FooterNav from "@components/layout/nav/footer-nav.astro";
import LegalNav from "@components/layout/nav/legal.astro";
import NewsletterSignup from "@components/promo/newsletter-signup.astro";
import { SITE_CONFIG } from "../../site.config";

interface Props {
  locale: string;
  isError?: boolean;
  isHome?: boolean;
}

const { locale, isHome } = Astro.props as Props;
const t = useTranslations(locale);
---

<footer role="contentinfo" class="from-stone-950 bg-linear-to-t to-stone-900 pt-14 text-white">
  <div class="container flex flex-col items-start justify-between gap-x-20 gap-y-10 px-7 md:flex-row">
    <div class="flex w-full flex-col items-center gap-5 border-b border-white/10 pb-10 text-center md:max-w-[350px] md:items-start md:border-0 md:text-left">
      <div class="w-auto max-w-[180px]">
        <a href={getLocaleUrl('/', locale)} class="block w-full select-none">
          <Image src={logoWhite} alt={themeConfig.name || "Botaz AI"} class="h-10 w-auto object-contain" />
        </a>
      </div>
      <div class="flex flex-col gap-1 text-balance text-stone-300">
        <div class="text-sm font-semibold">{t('meta.slogan')}</div>
        <div class="text-xs text-stone-400">{t('meta.sub-slogan')}</div>
      </div>

      <!-- Sosial Media Düymələri -->
      <div class="mt-8 md:mt-4">
        <div class="text-stone-400 mb-2.5 text-xs font-medium">Bizə qoşulun:</div>
        <div class="flex items-center justify-center space-x-3 lg:justify-start">
          <!-- Instagram -->
          <a class="btn-subtle rounded-full p-2.5 bg-stone-900 border border-stone-800 hover:bg-stone-800 transition-colors" title="Instagram" target="_blank" rel="noopener" href="https://instagram.com/botaz.ai">
            <Icon name="simple-icons:instagram" class="h-4 w-4 text-stone-300 hover:text-white" />
          </a>
          <!-- Facebook -->
          <a class="btn-subtle rounded-full p-2.5 bg-stone-900 border border-stone-800 hover:bg-stone-800 transition-colors" title="Facebook" target="_blank" rel="noopener" href="https://www.facebook.com/profile.php?id=61591120635315">
            <Icon name="simple-icons:facebook" class="h-4 w-4 text-stone-300 hover:text-white" />
          </a>
          <!-- WhatsApp -->
          <a class="btn-subtle rounded-full p-2.5 bg-stone-900 border border-stone-800 hover:bg-stone-800 transition-colors" title="WhatsApp" target="_blank" rel="noopener" href={SITE_CONFIG.whatsappUrl}>
            <Icon name="simple-icons:whatsapp" class="h-4 w-4 text-stone-300 hover:text-white" />
          </a>
        </div>
      </div>
    </div>
    
    <div class="flex w-full flex-col md:w-fit">
      <FooterNav {locale} {isHome} />
      {(themeConfig.promotions?.newsletterSignup === true || themeConfig.promotions?.newsletterSignup === 'footer') && <NewsletterSignup {locale} inFooter={true} />}
    </div>
  </div>
  
  <div class="container mt-10 flex flex-col flex-wrap items-center justify-between gap-x-14 gap-y-6 border-t border-white/10 py-6 pt-7 sm:flex-row-reverse">
    <LegalNav {locale} />
  </div>
</footer>