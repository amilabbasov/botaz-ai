---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import HeroChip from "@components/promo/hero-chip.astro";

import { themeConfig } from '~/theme.config';
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { SITE_CONFIG } from "../../site.config";
import heroMockup from "@images/botaz-hero-mockup.webp";

interface Props {
  locale: string;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);

function generateStars(count: number, spread = 3000): string {
  return Array.from({ length: count }, () => {
    const x = Math.floor(Math.random() * spread);
    const y = Math.floor(Math.random() * spread);
    const opacity = (0.4 + Math.random() * 0.6).toFixed(2);
    return `${x}px ${y}px rgba(255,255,255,${opacity})`;
  }).join(",");
}

const stars1 = generateStars(160); // 1 px - many
const stars2 = generateStars(60);  // 2 px - medium
const stars3 = generateStars(22);  // 3 px - few bright
---

<div role="banner" class="hero relative flex min-h-svh w-full flex-col items-center justify-center overflow-hidden px-6 pt-48 pb-24" style={`--stars1:${stars1};--stars2:${stars2};--stars3:${stars3};`}>
  <!-- Animated galaxy background -->
  <div class="galaxy-bg pointer-events-none">
    <div class="nebula"></div>
    <div class="s1 absolute inset-0"></div>
    <div class="s2 absolute inset-0"></div>
    <div class="s3 absolute inset-0"></div>
  </div>

  <!-- Hero content -->
  <div class="relative z-10 flex w-full max-w-5xl flex-col items-center gap-6 text-center">
    {themeConfig.promotions?.heroChip && <HeroChip {locale} />}

    <h1 class="hero-title flex flex-col items-center gap-1.5">
      <span>Sən Yatarkən,</span>
      <span>Botaz</span>
      <span>Biznesini <span style="color: #FFF535;">Oyaq</span> Saxlayır.</span>
    </h1>
    <p class="hero-subline">{t('pages.home.hero-sub-slogan')}</p>

    <div class="flex flex-col gap-10">
      <div class="mt-2 flex flex-wrap items-center justify-center gap-4">
        <a
          href={getLocaleUrl('pricing', locale)}
          class="group relative inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/[0.04] px-7 py-4 text-[17px] font-medium text-white/95 no-underline backdrop-blur-md transition-all duration-300 select-none hover:-translate-y-0.5 hover:border-[#00D9B1]/60 hover:bg-white/[0.09] hover:text-white hover:shadow-[0_0_25px_rgba(0,217,177,0.15)]"
        >
          <span>Qiymətlərə Bax</span>
        </a>
        <a
          href={SITE_CONFIG.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group hero-cta-pulse relative inline-flex items-center gap-2.5 rounded-xl bg-[#00D9B1] px-8.5 py-4 text-[17px] font-semibold text-stone-950 no-underline shadow-[0_0_25px_rgba(0,217,177,0.4)] transition-all duration-300 select-none hover:-translate-y-0.5 hover:bg-[#00f5c8] hover:shadow-[0_0_35px_rgba(0,217,177,0.6)]"
        >
          <span class="cta-text-anim">Botazı İşə Götür</span>
          <Icon name="heroicons:arrow-top-right-on-square" class="h-4.5 w-4.5 text-stone-950 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
      </div>
    </div>

    <!-- Botaz AI Dashboard / Chat Mockup Image -->
    <div class="border-primary/30 relative mt-12 w-full max-w-4xl overflow-hidden rounded-3xl border bg-white/5 p-2 shadow-[0_0_50px_rgba(0,217,177,0.15)] backdrop-blur-md">
      <Image src={heroMockup} alt="Botaz AI Instagram Satış İnterfeysi" class="h-auto w-full rounded-2xl object-cover" loading="eager" />
    </div>
  </div>
</div>

<style>
  @reference "../../styles/tailwind.config.css";

  /* ── Wrapper - Dark Background ── */
  .hero {
    background: radial-gradient(ellipse at 50% 40%, #06241e 0%, #081512 55%, #090a0f 100%);
    @apply px-4 sm:px-6;
  }

  /* ── Rotating galaxy container ── */
  .galaxy-bg {
    @apply absolute top-1/2 left-1/2 h-[3000px] w-[3000px] origin-center;
    animation: galaxyRotate 150s linear infinite;
  }

  @keyframes galaxyRotate {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  /* ── Nebula blobs - Botaz AI Neon Green / Dark Teal ── */
  .nebula {
    @apply absolute inset-0;
    background: radial-gradient(ellipse 55% 38% at 28% 38%, rgba(0, 217, 177, 0.25) 0%, transparent 65%), radial-gradient(ellipse 38% 28% at 72% 62%, rgba(0, 179, 146, 0.2) 0%, transparent 65%), radial-gradient(ellipse 48% 52% at 62% 22%, rgba(0, 217, 177, 0.15) 0%, transparent 60%), radial-gradient(ellipse 65% 42% at 42% 82%, rgba(9, 10, 15, 0.85) 0%, transparent 70%);
    animation: nebulaPulse 24s ease-in-out infinite alternate;
  }

  @keyframes nebulaPulse {
    0% {
      opacity: 0.72;
    }
    100% {
      opacity: 1;
    }
  }

  /* ── Star layers ── */
  .s1::before {
    content: '';
    @apply absolute top-0 left-0 size-px rounded-full bg-transparent;
    box-shadow: var(--stars1);
    animation: twinkle 10s ease-in-out infinite alternate;
  }

  .s2::before {
    content: '';
    @apply absolute top-0 left-0 size-[2px] rounded-full bg-transparent;
    box-shadow: var(--stars2);
    animation: twinkle 14s ease-in-out infinite alternate;
  }

  .s3::before {
    content: '';
    @apply absolute top-0 left-0 size-[3px] rounded-full bg-transparent;
    box-shadow: var(--stars3);
    animation: twinkle 18s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    0% {
      opacity: 0.6;
    }
    100% {
      opacity: 1;
    }
  }

  /* ── CTA Button Pulse & Text Animation ── */
  .hero-cta-pulse {
    animation: ctaPulse 3s ease-in-out infinite;
  }

  @keyframes ctaPulse {
    0%,
    100% {
      box-shadow: 0 0 25px rgba(0, 217, 177, 0.4);
    }
    50% {
      box-shadow:
        0 0 40px rgba(0, 217, 177, 0.7),
        0 0 15px rgba(0, 217, 177, 0.3);
    }
  }

  /* Mətnin rəng və parlaqlıq animasiyası */
  .cta-text-anim {
    animation: textGlowAnim 3s ease-in-out infinite;
  }

  @keyframes textGlowAnim {
    0%,
    100% {
      color: #03201a;
      text-shadow: none;
    }
    50% {
      color: #000000;
      text-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
    }
  }

  /* Title - Mobil ekranlar üçün adaptiv ölçü */
  .hero-title {
    @apply m-0 w-full text-center leading-[1.12] font-semibold tracking-[-0.02em] text-white;
    font-size: clamp(2.3rem, 7vw, 3.8rem);
    text-shadow: 0 0 90px rgba(0, 217, 177, 0.3);
  }

  /* Subline */
  .hero-subline {
    @apply m-0 max-w-[42rem] px-2 leading-[1.65] text-white/80;
    font-size: clamp(0.95rem, 2.2vw, 1.15rem);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .galaxy-bg,
    .nebula,
    .s1::before,
    .s2::before,
    .s3::before,
    .hero-cta-pulse,
    .cta-text-anim {
      animation: none;
    }
  }
</style>
