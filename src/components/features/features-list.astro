---
import { Icon } from "astro-icon/components";
import { SITE_CONFIG } from "../../site.config"; // Qovluq strukturunuza uyğun yolu yoxlayın

interface BotazFeature {
  title: string;
  tagline: string;
  detail: string;
  icon: string;
  accent: 'primary' | 'secondary';
}

const botazFeatures: BotazFeature[] = [
  {
    title: "Səsli Mesajları Anlama (Voice AI)",
    tagline: "Instagram daxilində səsli mesajların mənasını anında başa düşür.",
    detail: "Müştərilərin göndərdiyi istənilən səsli mesajı yüksək dəqiqliklə dinləyir, mənasını və sifariş müraciətini təhlil edir, sonra isə rəvan mətni və ya səsli cavab təqdim edir.",
    icon: "heroicons:sparkles",
    accent: "primary"
  },
  {
    title: "Vizual Şəkil Analizi (Vision AI)",
    tagline: "Şəkilləri, geyim fotolarını və skrinşotları tam oxuyur.",
    detail: "Müştəri bota bəyəndiyi məhsulun şəklini və ya ölçü cədvəlini atdıqda, Vision AI modeli şəkildəki geyimi və ya əşyanı tanıyır, bazadan stok və qiyməti tapır.",
    icon: "heroicons:photo",
    accent: "primary"
  },
  {
    title: "Xüsusi Satış Personaları",
    tagline: "Brendinizin ruhuna və dialektinə uyğun canlı insan üslubu.",
    detail: "Bota istədiyiniz xarakteri verə bilərsiniz — Naxçıvanlı Əmi, Ağdamlı Dayı, Gen-Z və ya Rəsmi Satış Mütəxəssisi. Müştəri robotla yox, canlı insanla danışdığını hiss edir.",
    icon: "heroicons:chat-bubble-bottom-center-text",
    accent: "secondary"
  },
  {
    title: "24/7 Avtomatik Satış və Lead Qəbulu",
    tagline: "Gecə saatlarında belə sifarişləri və müştəri nömrələrini toplayır.",
    detail: "Müştəri ilə razılaşan AI bota onun adını, telefon nömrəsini və çatdırılma ünvanını dəqiqləşdirir və anında təsdiqlənmiş sifariş yaratmaq üçün satıcıya ötürür.",
    icon: "heroicons:clock",
    accent: "primary"
  },
  {
    title: "Google Cədvəllər İnteqrasiyası",
    tagline: "Məhsul və qiymət bazası birbaşa Google Sheets-dən oxunur.",
    detail: "Hər dəfə qiyməti dəyişmək üçün kod yazmağa ehtiyac yoxdur. Google Cədvəlinizdə qiyməti yeniləyən kimi Botaz AI anında yeni qiymətlərlə cavab verməyə başlayır.",
    icon: "heroicons:table-cells",
    accent: "secondary"
  },
  {
    title: "Telegram və Email İntellektual Bildirişlər",
    tagline: "Sifariş yekunlaşan kimi anında cibinizə xəbərdarlıq gəlir.",
    detail: "Müştəri sifarişi təsdiqləyən kimi bütün detallar (müştərinin adı, nömrəsi, istədiyi məhsul və ünvan) Telegram qrupunuza və e-poçtunuza düşür.",
    icon: "heroicons:paper-airplane",
    accent: "secondary"
  }
];
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    botazFeatures.map((feature) => (
      <article class="feature-card group hover:border-primary/40 hover:shadow-primary/5 relative flex h-full flex-col justify-between overflow-hidden rounded-2xl border border-stone-800/80 bg-gradient-to-b from-stone-900/90 to-stone-950/90 p-7 shadow-xl transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl">
        {/* Üst vurğu xətti */}
        <div class={`absolute inset-x-0 top-0 h-1 transition-opacity duration-300 ${feature.accent === 'primary' ? 'from-primary/80 to-primary/20 bg-gradient-to-r' : 'bg-gradient-to-r from-stone-400 to-stone-700'}`} />

        <div>
          {/* İkon qutusu */}
          <div class="mb-5 flex items-center justify-between">
            <span class={`flex h-12 w-12 items-center justify-center rounded-xl transition-transform duration-300 group-hover:scale-110 ${feature.accent === 'primary' ? 'bg-primary/15 text-primary border-primary/20 border' : 'border border-stone-700/50 bg-stone-800/80 text-stone-300'}`}>
              <Icon name={feature.icon} class="h-6 w-6" aria-hidden="true" />
            </span>
            <span class="rounded-full border border-stone-700/40 bg-stone-800/60 px-2.5 py-1 text-[10px] font-bold tracking-wider text-stone-400 uppercase">Botaz AI</span>
          </div>

          {/* Başlıq və Tagline */}
          <h3 class="group-hover:text-primary mb-2 text-xl font-bold tracking-tight text-white transition-colors">{feature.title}</h3>
          <p class="mb-4 text-sm leading-snug font-medium text-stone-300">{feature.tagline}</p>

          {/* Detallı mətn - Oxunurluq üçün rəng optimizasiyası */}
          <p class="text-xs leading-relaxed text-stone-400 sm:text-sm">{feature.detail}</p>
        </div>

        {/* Alt hissə / Keçid düyməsi */}
        <div class="mt-8 flex items-center justify-between border-t border-stone-800/60 pt-4">
          <span class="text-xs font-medium text-stone-500">İmkanları kəşf et</span>
          <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="group-hover:text-primary inline-flex items-center gap-1.5 text-xs font-semibold text-stone-300 transition-colors">
            <span>Sınaqdan keçir</span>
            <Icon name="heroicons:arrow-right" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" />
          </a>
        </div>
      </article>
    ))
  }
</div>
